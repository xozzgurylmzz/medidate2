# Sunucunun dinleyeceği port
PORT=3000
# Sunucuda 127.0.0.1 yap (uygulamaya sadece Nginx üzerinden erişilsin)
HOST=0.0.0.0
# HTTPS kullanıyorsan true (çerezler sadece HTTPS ile gider)
COOKIE_SECURE=false
# Nginx arkasındaysan true (gerçek ziyaretçi IP'si için)
TRUST_PROXY=false

# Admin paneli (/admin). ADMIN_PASSWORD boşsa panel kapalı olur.
# Güçlü şifre üretmek için: openssl rand -base64 24
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
