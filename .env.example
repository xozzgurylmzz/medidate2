# --- Yerel geliştirme için örnek ayarlar (.env olarak kopyala) ---
# Vercel'de bu değerleri Settings > Environment Variables bölümüne gir (DEPLOY.md).

# Veritabanı (Turso). Yerelde boş bırakırsan data/medipoldate.sqlite dosyası kullanılır.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin paneli (/admin). ADMIN_PASSWORD boşsa panel kapalı olur.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Yerel sunucu
PORT=3000
# HTTPS kullanıyorsan true (Vercel'de otomatik true)
COOKIE_SECURE=false
# Nginx arkasında çalıştırıyorsan true (Vercel'de otomatik)
TRUST_PROXY=false
